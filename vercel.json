{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "python@4.3.0",
      "maxDuration": 30,
      "includeFiles": "{snaplocate/**,web/**,demo-repo/**,demo-cache/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
